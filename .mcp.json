{
  "mcpServers": {
    "playwright-test": {
      "command": "npx",
      "args": ["playwright", "run-test-mcp-server"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--test-id-attribute",
        "data-qa",
        "--viewport-size",
        "1280,720"
      ]
    }
  }
}
