# Copy to .env and fill in real values. .env is gitignored; this template is not.
#
# The credentials for the single shared account the login setup project signs
# into once per run, so tests that only need "a logged-in user" as a
# precondition never have to register one of their own. See
# utils/setup/login.setup.ts.
E2E_LOGIN_EMAIL=
E2E_LOGIN_PASSWORD=
